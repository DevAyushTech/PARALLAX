# Backend local configuration. No secrets are required for the deterministic MVP.
PARALLAX_DATABASE_URL=sqlite:///./parallax.db
PARALLAX_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional deterministic gate overrides for local experiments.
# PARALLAX_DECISION_GATE__FRESHNESS_SECONDS=900
# PARALLAX_DECISION_GATE__MATERIAL_CONFIDENCE=0.50
# PARALLAX_DECISION_GATE__ACT_CONFIDENCE=0.70
# PARALLAX_DECISION_GATE__SEVERE_CONFLICT_CONFIDENCE=0.85
# PARALLAX_DECISION_GATE__EQUAL_CONFIDENCE_TOLERANCE=0.05
